# 本地开发与 Docker Compose 环境变量示例。
# 复制为 .env 后按需修改；.env 已被 git 忽略，切勿提交真实密钥。
#
# Docker Compose 编排应用与小红书 MCP sidecar；Redis / MinIO 仍使用外部实例：
# - 数据库使用本地 SQLite 单文件（自动创建，无需安装）
# - Redis / MinIO 直接接入你已部署好的实例，不由 Compose 创建
# - MCP 登录 Cookie 保存在 mcp/xhs/data，目录已加入 git 忽略

# ---------- API 进程 ----------
API_HOST=127.0.0.1
API_PORT=4000
# Compose 对外发布端口（默认仅绑定本机回环地址）
# API_PUBLISHED_PORT=4000
# CONSOLE_PORT=3000
# TUTOR_FLOW_BIND_ADDRESS=127.0.0.1
# SQLite 数据库文件路径（自动创建父目录）
SQLITE_PATH=./data/tutor-flow.db
# Compose 默认访问宿主机 Redis；本机源码开发时改为 127.0.0.1，远程部署填容器可达地址
REDIS_URL=redis://host.docker.internal:6379

# 外部调度器 Bearer 令牌（缺省时调度器触发接口不可用）
# SCHEDULER_TOKEN=generate-a-long-random-token

# 兼容服务端调用的运营 Bearer 令牌；管理台网页登录不使用此值
# OPERATOR_TOKEN=generate-another-long-random-token

# 管理后台首次启动账号；只在数据库尚无 SUPER_ADMIN 时创建，不会覆盖已有密码
# 管理员密码至少 5 位
BOOTSTRAP_SUPER_ADMIN_USERNAME=admin
BOOTSTRAP_SUPER_ADMIN_PASSWORD=change-me-now-123

# 内容中心 k-File（MinIO 凭据只配置在 k-File，不进入本项目）
# CONTENT_CENTER_URL=http://127.0.0.1:8080
# CONTENT_CENTER_TOKEN_REF=env:KFILE_APP_TOKEN
# KFILE_APP_TOKEN=replace-with-k-file-open-app-token

# ---------- Worker 进程 ----------

# 小红书 MCP sidecar（使用根目录 docker-compose.yml 启动）
# 可选：指定 MCP 镜像仓库或带 tag 的完整镜像引用；不配置时使用上游默认镜像
# XHS_MCP_IMAGE_REPOSITORY=xpzouying/xiaohongshu-mcp
# Compose 内 API/Worker 自动通过服务名连接；宿主机源码开发使用下面的 URL
# XHS_MCP_URL=http://127.0.0.1:18060/mcp
# XHS_MCP_PORT=18060
XHS_MCP_ACCOUNT_ID=00000000-0000-4000-8000-000000000001
# 如 MCP 前的代理启用 Bearer 鉴权，由 API 和 Worker 服务端解析令牌，不传给浏览器
# XHS_MCP_AUTH_TOKEN_REF=env:XHS_MCP_AUTH_TOKEN
# XHS_MCP_AUTH_TOKEN=replace-with-upstream-auth-token
# ---------- 管理台（Next.js 服务端） ----------
CONSOLE_API_BASE_URL=http://127.0.0.1:4000
# 浏览器端可见的非敏感配置必须使用 NEXT_PUBLIC_ 前缀
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000

# ---------- 通用 ----------
LOG_LEVEL=info
NODE_ENV=development
