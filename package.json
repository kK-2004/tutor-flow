{
  "name": "tutor-flow",
  "version": "0.1.0",
  "private": true,
  "description": "小红书单平台内容生产工作台（研究、选题、生成、审核、发布闭环）",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:console-icons": "node scripts/check-console-icons.mjs",
    "check:console-coverage": "node scripts/check-console-coverage.mjs",
    "security:scan": "node scripts/security-scan.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r build && vitest run",
    "test:watch": "vitest",
    "dev:console": "pnpm --filter @tutor-flow/console dev",
    "dev:api": "pnpm --filter @tutor-flow/api dev",
    "dev:worker": "pnpm --filter @tutor-flow/worker dev",
    "db:migrate": "pnpm --filter @tutor-flow/db... build && pnpm --filter @tutor-flow/db migrate",
    "db:generate": "pnpm --filter @tutor-flow/db generate"
  },
  "devDependencies": {
    "@libsql/client": "^0.18.0",
    "@tutor-flow/config": "workspace:*",
    "@tutor-flow/db": "workspace:*",
    "@tutor-flow/domain": "workspace:*",
    "@tutor-flow/integrations": "workspace:*",
    "@tutor-flow/workflow": "workspace:*",
    "bullmq": "^6.3.8",
    "drizzle-orm": "^0.45.3",
    "eslint": "^10.11.0",
    "ioredis": "^6.0.0",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver",
      "@swc/core",
      "workerd",
      "core-js",
      "bson",
      "msgpackr-extract"
    ]
  }
}
