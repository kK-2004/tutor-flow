# 复制为 .env；真实密钥不要提交到仓库。
# Docker Compose 默认连接宿主机 Redis；源码运行时通常改为 redis://127.0.0.1:6379。
REDIS_URL=redis://host.docker.internal:6379

# 检索需要 Brave；模型 Provider 在管理台“系统设置”中配置。
# BRAVE_API_KEY=replace-with-brave-key

# 首次创建管理员时使用；已有管理员不会被覆盖。
BOOTSTRAP_SUPER_ADMIN_USERNAME=admin
BOOTSTRAP_SUPER_ADMIN_PASSWORD=change-me-now-123

# 需要上传图片到内容中心时再配置。
# CONTENT_CENTER_URL=http://127.0.0.1:8080
# KFILE_APP_TOKEN=replace-with-k-file-open-app-token
