{
  "name": "@tutor-flow/db",
  "version": "0.1.0",
  "private": true,
  "description": "SQLite 迁移、schema 定义与仓储方法",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/scripts/migrate.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@tutor-flow/config": "workspace:*",
    "@tutor-flow/domain": "workspace:*",
    "drizzle-orm": "^0.45.3"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
