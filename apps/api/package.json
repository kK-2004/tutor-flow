{
  "name": "@tutor-flow/api",
  "version": "0.1.0",
  "private": true,
  "description": "控制面 API（Fastify）：运行任务、草稿、发布任务、设置与 SSE 事件流",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tutor-flow/config": "workspace:*",
    "@tutor-flow/db": "workspace:*",
    "@tutor-flow/domain": "workspace:*",
    "@tutor-flow/integrations": "workspace:*",
    "@tutor-flow/observability": "workspace:*",
    "@tutor-flow/workflow": "workspace:*",
    "fastify": "^5.12.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
